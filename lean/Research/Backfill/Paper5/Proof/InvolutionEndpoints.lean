import Mathlib

set_option autoImplicit false

namespace CodexPaper5.InvolutionEndpoints

open Function

variable {V : Type*}

/-- The actual simple graph generated by the two moving involution edges.
`fromRel` removes loops and adds reverse edges. -/
def movingGraph (α β : Equiv.Perm V) : SimpleGraph V :=
  SimpleGraph.fromRel (fun u v => α u = v ∨ β u = v)

/-- Functional involutivity gives the corresponding equality in the actual permutation group. -/
theorem mul_self_eq_one (α : Equiv.Perm V) (hα : Involutive α) : α * α = 1 := by
  ext v
  exact hα v

theorem inv_eq_self (α : Equiv.Perm V) (hα : Involutive α) : α⁻¹ = α := by
  ext v
  apply α.injective
  change α (α.symm v) = α (α v)
  exact (α.apply_symm_apply v).trans (hα v).symm

/-- Conjugating αβ by α reverses it; the multiplication order is the ordinary left action. -/
theorem alpha_tau_semiconj (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β) :
    SemiconjBy α (α * β) (α * β)⁻¹ := by
  change α * (α * β) = (α * β)⁻¹ * α
  calc
    α * (α * β) = (α * α) * β := (mul_assoc α α β).symm
    _ = β := by rw [mul_self_eq_one α hα, one_mul]
    _ = β * (α * α) := by rw [mul_self_eq_one α hα, mul_one]
    _ = (β * α) * α := (mul_assoc β α α).symm
    _ = (α * β)⁻¹ * α := by
      rw [mul_inv_rev, inv_eq_self α hα, inv_eq_self β hβ]

/-- At an α-fixed base point, α reflects every integer orbit coordinate. -/
theorem alpha_reflect (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β)
    {a : V} (ha : α a = a) (k : ℤ) :
    α (((α * β) ^ k) a) = ((α * β) ^ (-k)) a := by
  have hperm : α * ((α * β) ^ k) = ((α * β) ^ (-k)) * α := by
    simpa only [SemiconjBy, inv_zpow'] using (alpha_tau_semiconj α β hα hβ).zpow_right k
  have hpoint := congrArg (fun p : Equiv.Perm V => p a) hperm
  simpa only [Equiv.Perm.mul_apply, ha] using hpoint

/-- The second involution reflects k to -(k+1), since β = α(αβ). -/
theorem beta_reflect (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β)
    {a : V} (ha : α a = a) (k : ℤ) :
    β (((α * β) ^ k) a) = ((α * β) ^ (-(k + 1))) a := by
  calc
    β (((α * β) ^ k) a) = α ((α * β) (((α * β) ^ k) a)) :=
      (hα (β (((α * β) ^ k) a))).symm
    _ = α (((α * β) ^ (k + 1)) a) := by
      rw [show k + 1 = (1 : ℤ) + k by omega, zpow_add, zpow_one, Equiv.Perm.mul_apply]
      rfl
    _ = ((α * β) ^ (-(k + 1))) a := alpha_reflect α β hα hβ ha (k + 1)

/-- Reverse generator edges are genuine forward edges because both generators are involutions. -/
theorem adj_cases (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β)
    {u v : V} (h : (movingGraph α β).Adj u v) : α u = v ∨ β u = v := by
  change u ≠ v ∧ ((α u = v ∨ β u = v) ∨ (α v = u ∨ β v = u)) at h
  rcases h with ⟨_hne, h | h⟩
  · exact h
  · rcases h with h | h
    · left
      calc
        α u = α (α v) := congrArg α h.symm
        _ = v := hα v
    · right
      calc
        β u = β (β v) := congrArg β h.symm
        _ = v := hβ v

theorem sameCycle_alpha (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β)
    {a u : V} (ha : α a = a) (hu : (α * β).SameCycle a u) :
    (α * β).SameCycle a (α u) := by
  obtain ⟨k, hk⟩ := hu
  refine ⟨-k, ?_⟩
  exact (alpha_reflect α β hα hβ ha k).symm.trans (congrArg α hk)

theorem sameCycle_beta (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β)
    {a u : V} (ha : α a = a) (hu : (α * β).SameCycle a u) :
    (α * β).SameCycle a (β u) := by
  obtain ⟨k, hk⟩ := hu
  refine ⟨-(k + 1), ?_⟩
  exact (beta_reflect α β hα hβ ha k).symm.trans (congrArg β hk)

/-- Actual graph reachability from an α-fixed point stays in the integer orbit of αβ.
No finite-type or preselected path hypothesis is used. -/
theorem sameCycle_of_reachable (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β)
    {a b : V} (ha : α a = a) (hab : (movingGraph α β).Reachable a b) :
    (α * β).SameCycle a b := by
  have hpath := ((movingGraph α β).reachable_iff_reflTransGen a b).mp hab
  clear hab
  induction hpath with
  | refl => exact Equiv.Perm.SameCycle.rfl
  | tail _ huv ih =>
    rcases adj_cases α β hα hβ huv with huv | huv
    · exact huv ▸ sameCycle_alpha α β hα hβ ha ih
    · exact huv ▸ sameCycle_beta α β hα hβ ha ih

/-- A β-fixed point in coordinate k gives the actual odd return exponent 2k+1. -/
theorem odd_return_of_beta_fixed (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β)
    {a : V} (ha : α a = a) (k : ℤ) (hk : β (((α * β) ^ k) a) = ((α * β) ^ k) a) :
    ((α * β) ^ (2 * k + 1)) a = a := by
  let τ := α * β
  have hreflect : (τ ^ (-(k + 1))) a = (τ ^ k) a :=
    (beta_reflect α β hα hβ ha k).symm.trans hk
  calc
    (τ ^ (2 * k + 1)) a = ((τ ^ (k + 1)) * (τ ^ k)) a := by
      rw [show 2 * k + 1 = (k + 1) + k by ring, zpow_add]
    _ = (τ ^ (k + 1)) ((τ ^ k) a) := rfl
    _ = (τ ^ (k + 1)) ((τ ^ (-(k + 1))) a) := congrArg _ hreflect.symm
    _ = ((τ ^ (k + 1)) * (τ ^ (-(k + 1)))) a := rfl
    _ = a := by rw [← zpow_add, add_neg_cancel, zpow_zero]; rfl

/-- Two odd return exponents force the difference of their orbit coordinates to return.
This is the explicit integer identity k(2l+1)-l(2k+1)=k-l, not a finiteness assumption. -/
theorem difference_return (τ : Equiv.Perm V) {a : V} (k l : ℤ)
    (hk : (τ ^ (2 * k + 1)) a = a) (hl : (τ ^ (2 * l + 1)) a = a) :
    (τ ^ (k - l)) a = a := by
  have hk' : (τ ^ ((2 * k + 1) * (-l))) a = a := by
    rw [zpow_mul]
    exact Equiv.Perm.zpow_apply_eq_self_of_apply_eq_self hk (-l)
  have hl' : (τ ^ ((2 * l + 1) * k)) a = a := by
    rw [zpow_mul]
    exact Equiv.Perm.zpow_apply_eq_self_of_apply_eq_self hl k
  rw [show k - l = (2 * l + 1) * k + (2 * k + 1) * (-l) by ring,
    zpow_add, Equiv.Perm.mul_apply, hk', hl']

/-- The cross-color endpoint of a reachable component is unique.
This holds on arbitrary types, without a finite or periodic-orbit hypothesis. -/
theorem endpoints_unique (α β : Equiv.Perm V) (hα : Involutive α) (hβ : Involutive β)
    {a b c : V} (ha : α a = a) (hb : β b = b) (hc : β c = c)
    (hab : (movingGraph α β).Reachable a b) (hac : (movingGraph α β).Reachable a c) : b = c := by
  obtain ⟨k, hk⟩ := sameCycle_of_reachable α β hα hβ ha hab
  obtain ⟨l, hl⟩ := sameCycle_of_reachable α β hα hβ ha hac
  have hbk : β (((α * β) ^ k) a) = ((α * β) ^ k) a := by rw [hk, hb]
  have hcl : β (((α * β) ^ l) a) = ((α * β) ^ l) a := by rw [hl, hc]
  have hreturn : ((α * β) ^ (k - l)) a = a :=
    difference_return (α * β) k l
      (odd_return_of_beta_fixed α β hα hβ ha k hbk)
      (odd_return_of_beta_fixed α β hα hβ ha l hcl)
  calc
    b = ((α * β) ^ k) a := hk.symm
    _ = ((α * β) ^ (l + (k - l))) a :=
      congrArg (fun z : ℤ => ((α * β) ^ z) a) (by ring)
    _ = ((α * β) ^ l) (((α * β) ^ (k - l)) a) := by rw [zpow_add]; rfl
    _ = ((α * β) ^ l) a := congrArg _ hreturn
    _ = c := hl

#print axioms CodexPaper5.InvolutionEndpoints.alpha_reflect
#print axioms CodexPaper5.InvolutionEndpoints.beta_reflect
#print axioms CodexPaper5.InvolutionEndpoints.adj_cases
#print axioms CodexPaper5.InvolutionEndpoints.sameCycle_of_reachable
#print axioms CodexPaper5.InvolutionEndpoints.odd_return_of_beta_fixed
#print axioms CodexPaper5.InvolutionEndpoints.difference_return
#print axioms CodexPaper5.InvolutionEndpoints.endpoints_unique

end CodexPaper5.InvolutionEndpoints
