private def D_1_00 (u v : Fin 1) : ℕ :=
  ![![0]] u v

private theorem cert_1_00 :
    (∀ x : Fin 1, D_1_00 x x = 0) ∧
    (∀ x y : Fin 1, D_1_00 x y = 0 → x = y) ∧
    (∀ x y : Fin 1, D_1_00 x y ≠ 0 →
      ∃ z : Fin 1, (reps 1 0).Adj x z ∧ D_1_00 z y + 1 = D_1_00 x y) ∧
    (∀ u v w : Fin 1, (reps 1 0).Adj u v → D_1_00 u w ≤ D_1_00 v w + 1) := by
  decide +kernel

private theorem hD_1_00 : ∀ x y, (reps 1 0).dist x y = D_1_00 x y :=
  dist_eq_of_certificate (reps 1 0) D_1_00 cert_1_00.1 cert_1_00.2.1 cert_1_00.2.2.1
    cert_1_00.2.2.2

private theorem hc_1_00 : (reps 1 0).Connected :=
  connected_of_dist (reps 1 0) D_1_00 hD_1_00 cert_1_00.2.1

theorem med_1_00 : Challenge.IsMedian (reps 1 0) :=
  median_of_table (reps 1 0) D_1_00 hc_1_00 hD_1_00 (by unfold ExistsUnique; decide +kernel)


