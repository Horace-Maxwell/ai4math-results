theorem copies_L8 (j : Fin 69) :
    Nat.card {G : SimpleGraph (Fin 8) // Nonempty (G ≃g L8 j)} = 40320 / autCounts j := by
  have h := orbit_card (L8 j)
  rw [aut_L8 j, Fintype.card_fin, show Nat.factorial 8 = 40320 by decide] at h
  have hpos : 0 < autCounts j := by
    rcases Nat.eq_zero_or_pos (autCounts j) with h0 | h0
    · rw [h0, mul_zero] at h
      exact absurd h (by decide)
    · exact h0
  exact (Nat.div_eq_of_eq_mul_left hpos h.symm).symm

open Classical in
theorem median_eq_biUnion :
    (univ.filter fun G : SimpleGraph (Fin 8) => Challenge.IsMedian G) =
      (univ : Finset (Fin 69)).biUnion fun j => univ.filter fun G => Nonempty (G ≃g L8 j) := by
  ext G
  simp only [mem_filter, mem_univ, true_and, mem_biUnion]
  constructor
  · intro hm
    exact cover8 (Fin 8) G (by simp) hm
  · rintro ⟨j, ⟨e⟩⟩
    exact (MedianMetricTransport.isMedian_iff e).mpr (L8_median j)

open Classical in
theorem card_copies_L8 (j : Fin 69) :
    #(univ.filter fun G : SimpleGraph (Fin 8) => Nonempty (G ≃g L8 j)) = 40320 / autCounts j := by
  rw [← copies_L8 j, Nat.card_eq_fintype_card, Fintype.card_subtype]

theorem card_median8 : Nat.card {G : SimpleGraph (Fin 8) // Challenge.IsMedian G} = 1008904 := by
  classical
  rw [Nat.card_eq_fintype_card, Fintype.card_subtype, median_eq_biUnion, card_biUnion]
  · rw [sum_congr rfl fun j _ => card_copies_L8 j]
    decide +kernel
  · intro j _ k _ hjk
    refine disjoint_left.mpr fun G hj hk => hjk ?_
    simp only [mem_filter, mem_univ, true_and] at hj hk
    obtain ⟨ej⟩ := hj
    obtain ⟨ek⟩ := hk
    exact L8_pairwise j k ⟨ej.symm.trans ek⟩

theorem notQ3'_iff (G : SimpleGraph (Fin 8)) :
    (Challenge.IsMedian G ∧ ¬ Challenge.Question3' G) ↔ Nonempty (G ≃g Challenge.G1) := by
  constructor
  · rintro ⟨hm, hq⟩
    exact check_TheoremA_unique (Fin 8) G (by simp) hm hq
  · rintro ⟨e⟩
    have hm : Challenge.IsMedian G :=
      (MedianMetricTransport.isMedian_iff e).mpr ConcreteCore.G1_median
    exact ⟨hm, fun hq =>
      check_TheoremA_i.2.2.2.2.2.1 ((MedianMetricTransport.question3'_iff e hm.1).mp hq)⟩

theorem notQ4_iff (G : SimpleGraph (Fin 8)) :
    (Challenge.IsMedian G ∧ ¬ Challenge.Question4 G) ↔ Nonempty (G ≃g Challenge.G2) := by
  constructor
  · rintro ⟨hm, hq⟩
    exact (check_TheoremB_unique (Fin 8) G (by simp) hm).1 hq
  · rintro ⟨e⟩
    have hm : Challenge.IsMedian G :=
      (MedianMetricTransport.isMedian_iff e).mpr ConcreteCore.G2_median
    exact ⟨hm, fun hq =>
      check_TheoremB_ii.2.2.2.2.2.2.2.1 ((MedianMetricTransport.question4_iff e hm.1).mp hq)⟩

theorem check_Sec4_count_labelled : Challenge.Sec4_count_labelled := by
  refine ⟨card_median8, ?_, ?_⟩
  · rw [Nat.card_congr (Equiv.subtypeEquivRight notQ3'_iff)]
    have h := orbit_card Challenge.G1
    rw [check_Sec4_aut.1, Fintype.card_fin, show Nat.factorial 8 = 40320 by decide] at h
    omega
  · rw [Nat.card_congr (Equiv.subtypeEquivRight notQ4_iff)]
    have h := orbit_card Challenge.G2
    rw [check_Sec4_aut.2, Fintype.card_fin, show Nat.factorial 8 = 40320 by decide] at h
    omega

#print axioms check_Sec4_count_labelled

