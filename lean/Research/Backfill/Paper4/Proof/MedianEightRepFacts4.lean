private def D_40 (u v : Fin 8) : ℕ :=
  ![![0, 1, 4, 2, 2, 3, 3, 1],
    ![1, 0, 3, 1, 1, 2, 2, 2],
    ![4, 3, 0, 2, 4, 5, 1, 3],
    ![2, 1, 2, 0, 2, 3, 1, 1],
    ![2, 1, 4, 2, 0, 1, 3, 3],
    ![3, 2, 5, 3, 1, 0, 4, 4],
    ![3, 2, 1, 1, 3, 4, 0, 2],
    ![1, 2, 3, 1, 3, 4, 2, 0]] u v

private theorem cert_40 :
    (∀ x : Fin 8, D_40 x x = 0) ∧
    (∀ x y : Fin 8, D_40 x y = 0 → x = y) ∧
    (∀ x y : Fin 8, D_40 x y ≠ 0 →
      ∃ z : Fin 8, (L8 40).Adj x z ∧ D_40 z y + 1 = D_40 x y) ∧
    (∀ u v w : Fin 8, (L8 40).Adj u v → D_40 u w ≤ D_40 v w + 1) := by
  decide +kernel

private theorem hD_40 : ∀ x y, (L8 40).dist x y = D_40 x y :=
  dist_eq_of_certificate (L8 40) D_40 cert_40.1 cert_40.2.1 cert_40.2.2.1 cert_40.2.2.2

private theorem hc_40 : (L8 40).Connected :=
  connected_of_dist (L8 40) D_40 hD_40 cert_40.2.1

theorem median_40 : Challenge.IsMedian (L8 40) :=
  median_of_table (L8 40) D_40 hc_40 hD_40 (by unfold ExistsUnique; decide +kernel)


theorem q_40 : (Challenge.Question3' (L8 40) ∧ Challenge.Question4 (L8 40)) ∨
    Nonempty (L8 40 ≃g Challenge.G1) ∨ Nonempty (L8 40 ≃g Challenge.G2) := by
  have hd : (L8 40).diam = 5 :=
    diam_eq_of_table (L8 40) D_40 hc_40 hD_40 5 (by decide +kernel) 2 5 (by decide +kernel)
  have ht : Challenge.triameter (L8 40) = 12 :=
    triameter_eq_of_table (L8 40) D_40 hD_40 12 (by decide +kernel) 0 2 5 (by decide +kernel)
  exact Or.inl ⟨question3'_of_table (L8 40) D_40 hc_40 hD_40 5 12 hd ht (by decide +kernel),
    question4_of_table (L8 40) D_40 hD_40 5 12 hd ht (by decide +kernel)⟩


