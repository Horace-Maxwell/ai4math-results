import Research.Backfill.Paper4.Proof.SmallMedianFacts
import Research.Backfill.Paper4.Proof.MedianEight
import Research.Backfill.Paper4.Proof.TriangleFreeFingerprint

/-!
# `Sec4_count_median`: the numbers of median graphs with 1, …, 8 vertices, up to isomorphism, are
1, 1, 1, 3, 4, 11, 23, 69

(Written by Claude, 2026-09-28; the lists and fingerprints are generated by `gen_small.py` and
checked by the kernel.) For `n ≤ 7` the representatives are the median ones among Codex's
connected triangle-free representatives `reps n`; every median graph is triangle-free, hence
isomorphic to some `reps n i`, which cannot be a non-median one. For `n = 8` they are `L8`.
-/
set_option autoImplicit false
set_option maxRecDepth 8192

namespace ClaudePaper4
open BackfillPaper4 CodexPaper4 CodexPaper4.TriangleFreeEnumerationCore
  CodexPaper4.TriangleFreeEnumerationFamily CodexPaper4.TriangleFreeFingerprint

theorem classCount_small (n m : ℕ) (hn1 : 1 ≤ n) (hn7 : n ≤ 7) (idx : Fin m → Fin (repCount n))
    (hmed : ∀ k, Challenge.IsMedian (reps n (idx k)))
    (hnon : ∀ i, (∀ k, idx k ≠ i) → ¬ Challenge.IsMedian (reps n i))
    (hpair : ∀ k k', Nonempty (reps n (idx k) ≃g reps n (idx k')) → k = k') :
    Challenge.ClassCount (fun G => Challenge.IsMedian G) n m := by
  refine ⟨fun k => reps n (idx k), hmed, hpair, ?_⟩
  intro W _ G hcard hm
  have ht : G.CliqueFree 3 := check_Sec4_median_triangleFree W G hm
  have hcov := covers_through_seven repCount reps (covers_one (reps 1) 0)
    TriangleFreeEnumerationLayers.layers n hn1 hn7
  obtain ⟨i, ⟨e⟩⟩ := hcov W G hcard hm.1 ht
  by_cases h : ∃ k, idx k = i
  · obtain ⟨k, rfl⟩ := h
    exact ⟨k, ⟨e⟩⟩
  · exact absurd ((MedianMetricTransport.isMedian_iff e).mp hm) (hnon i fun k hk => h ⟨k, hk⟩)

theorem pairwise_of_fp {n m : ℕ} (L : Fin m → SimpleGraph (Fin n)) [∀ k, DecidableRel (L k).Adj]
    (fps : Fin m → Multiset ℕ) (hfp : ∀ k, graphFingerprint (L k) = fps k)
    (hinj : Function.Injective fps) :
    ∀ k k', Nonempty (L k ≃g L k') → k = k' := by
  rintro k k' ⟨e⟩
  apply hinj
  have he := graphFingerprint_iso e
  rw [hfp k', hfp k] at he
  exact he.symm


def idx1 : Fin 1 → Fin (repCount 1) := ![0]

def fps1 : Fin 1 → Multiset ℕ := ![
  (([0] : List ℕ) : Multiset ℕ)]

theorem count1 : Challenge.ClassCount (fun G => Challenge.IsMedian G) 1 1 := by
  refine classCount_small 1 1 (by norm_num) (by norm_num) idx1 ?_ ?_ ?_
  · intro k
    fin_cases k
    · exact SmallMedianFacts.med_1_00
  · intro i
    fin_cases i
    · exact fun h => (h 0 (by decide)).elim
  · refine pairwise_of_fp (fun k => reps 1 (idx1 k)) fps1 ?_ (by decide +kernel)
    intro k
    fin_cases k
    · decide +kernel


