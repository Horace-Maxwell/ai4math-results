private def D_30 (u v : Fin 8) : ℕ :=
  ![![0, 2, 3, 3, 1, 4, 4, 2],
    ![2, 0, 1, 1, 1, 2, 2, 2],
    ![3, 1, 0, 2, 2, 1, 1, 3],
    ![3, 1, 2, 0, 2, 3, 3, 1],
    ![1, 1, 2, 2, 0, 3, 3, 1],
    ![4, 2, 1, 3, 3, 0, 2, 4],
    ![4, 2, 1, 3, 3, 2, 0, 4],
    ![2, 2, 3, 1, 1, 4, 4, 0]] u v

private theorem cert_30 :
    (∀ x : Fin 8, D_30 x x = 0) ∧
    (∀ x y : Fin 8, D_30 x y = 0 → x = y) ∧
    (∀ x y : Fin 8, D_30 x y ≠ 0 →
      ∃ z : Fin 8, (L8 30).Adj x z ∧ D_30 z y + 1 = D_30 x y) ∧
    (∀ u v w : Fin 8, (L8 30).Adj u v → D_30 u w ≤ D_30 v w + 1) := by
  decide +kernel

private theorem hD_30 : ∀ x y, (L8 30).dist x y = D_30 x y :=
  dist_eq_of_certificate (L8 30) D_30 cert_30.1 cert_30.2.1 cert_30.2.2.1 cert_30.2.2.2

private theorem hc_30 : (L8 30).Connected :=
  connected_of_dist (L8 30) D_30 hD_30 cert_30.2.1

theorem median_30 : Challenge.IsMedian (L8 30) :=
  median_of_table (L8 30) D_30 hc_30 hD_30 (by unfold ExistsUnique; decide +kernel)


theorem q_30 : (Challenge.Question3' (L8 30) ∧ Challenge.Question4 (L8 30)) ∨
    Nonempty (L8 30 ≃g Challenge.G1) ∨ Nonempty (L8 30 ≃g Challenge.G2) := by
  have hd : (L8 30).diam = 4 :=
    diam_eq_of_table (L8 30) D_30 hc_30 hD_30 4 (by decide +kernel) 0 5 (by decide +kernel)
  have ht : Challenge.triameter (L8 30) = 10 :=
    triameter_eq_of_table (L8 30) D_30 hD_30 10 (by decide +kernel) 0 3 5 (by decide +kernel)
  exact Or.inl ⟨question3'_of_table (L8 30) D_30 hc_30 hD_30 4 10 hd ht (by decide +kernel),
