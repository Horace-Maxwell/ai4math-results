import Research.Backfill.Paper3.Proof.TS.Count
import Research.Backfill.Paper3.Proof.TS.Row

/-!
# Table 2, `d = 3`: data and kernel checks

The 2 classes of 3-regular graphs on 6 vertices (adjacency codes), the histograms and
`N_{≤t}` profiles, and the 2-switch certificates; generated by `gen/gen_table2.py`, every fact
checked by the kernel (`decide +kernel` on the checkers of `Research.Backfill.Paper3.Proof.TS.Code` and `Research.Backfill.Paper3.Proof.TS.Count`).
-/

set_option autoImplicit false

namespace P3TS.D3

open Finset BackfillPaper3.Challenge P3TS


def c0 : ℕ := 7635701304

def c1 : ℕ := 7740295794

/-- Adjacency codes of the 2 representatives. -/
def codes : List ℕ :=
  [c0, c1]

def h0 : List ℕ :=
  [15, 9, 18, 6, 9, 0, 6, 0, 0, 1, 0, 0, 0, 0, 0, 0]

def h1 : List ℕ :=
  [13, 15, 12, 8, 9, 0, 6, 0, 0, 1, 0, 0, 0, 0, 0, 0]

/-- Histograms of `e(A)`: entry `s` is the number of vertex sets with `s` edges. -/
def hists : List (List ℕ) :=
  [h0, h1]

def p0 : List ℕ :=
  [15, 24, 42, 48, 57, 57, 63, 63, 63, 64]

def p1 : List ℕ :=
  [13, 28, 40, 48, 57, 57, 63, 63, 63, 64]

/-- `N_{≤t}` for `t = 0, …, d²`. -/
def prof : List (List ℕ) :=
  [p0, p1]


/-- The representatives. -/
abbrev R (i : Fin 2) : SimpleGraph (Fin (2 * 3)) := ofCode (2 * 3) (codes.getD i 0)

/-- `N_{≤t}` of the representatives (from the table `prof`). -/
def P (i : Fin 2) (t : ℕ) : ℕ := (prof.getD i []).getD t 0

theorem wf_deg : allLt 2 (fun j => wfB (2 * 3) (codes.getD j 0) &&
    allLt (2 * 3) (fun v => degB (2 * 3) (codes.getD j 0) v == 3)) = true := by
  decide +kernel

theorem hist_ok : allLt 2 (fun j => (hists.getD j []).length == 16 &&
    (hists.getD j []).all (fun x => decide (x < 2048))) = true := by
  decide +kernel

theorem prof_ok : allLt 2 (fun j => (prof.getD j []).length == 3 ^ 2 + 1 && allLt (3 ^ 2 + 1)
    (fun t => (prof.getD j []).getD t 0 == sumLt (t + 1) (fun s => (hists.getD j []).getD s 0))) =
    true := by
  decide +kernel

theorem wf (j : ℕ) (hj : j < 2) : wfB (2 * 3) (codes.getD j 0) = true := by
  have h := allLt_iff.1 wf_deg j hj
  rw [Bool.and_eq_true] at h
  exact h.1

theorem hdeg (i : Fin 2) (v : Fin (2 * 3)) : (nbr (R i) v).card = 3 := by
  rw [card_nbr_ofCode (wf i i.isLt)]
  have h := allLt_iff.1 wf_deg i i.isLt
  rw [Bool.and_eq_true, allLt_iff] at h
  simpa using h.2 v v.isLt

theorem prof_len (i : Fin 2) : (prof.getD i []).length = 3 ^ 2 + 1 := by
  have h := allLt_iff.1 prof_ok i i.isLt
  rw [Bool.and_eq_true, beq_iff_eq] at h
  exact h.1

theorem hK : Nonempty (Kdd 3 ≃g R 0) :=
  ⟨⟨finSumFinEquiv.trans (finCongr (by norm_num)), by intro a b; revert a b; decide⟩⟩

def certs0 : List (ℕ × ℕ × ℕ) :=
  [(1, 5517840, 5517840), (1, 5517600, 5517600), (1, 4534800, 4534800), (1, 4534560, 4534560),
    (1, 5456400, 5456400), (1, 5456160, 5456160), (1, 4411920, 3490320), (1, 4411680, 3490080),
    (1, 3490320, 4411920), (1, 3490080, 4411680), (1, 3428880, 3428880), (1, 3428640, 3428640),
    (1, 4526880, 4530480), (1, 5509920, 5513520), (1, 4526640, 4526640), (1, 5325600, 5448000),
    (1, 5509680, 5509680), (1, 5325360, 5444160)]

theorem chk0 : chk (2 * 3) 2 (codes.getD 0 0) codes (tuples (2 * 3)) certs0 = true := by
  decide +kernel

theorem poly0 : polyH (2 * 3) (codes.getD 0 0) = ofD (hists.getD 0 []) := by
  decide +kernel

def certs1 : List (ℕ × ℕ × ℕ) :=
  [(1, 4526640, 4526640), (1, 5517600, 5517600), (0, 5517840, 5517840), (1, 5456400, 5456400),
    (1, 5387280, 5387280), (1, 3481920, 4281120), (0, 2430000, 4330800), (1, 3428880, 3428880),
    (1, 5514000, 5514000), (0, 5513520, 5509920), (1, 4534800, 4534800), (1, 5321280, 5321280)]

theorem chk1 : chk (2 * 3) 2 (codes.getD 1 0) codes (tuples (2 * 3)) certs1 = true := by
  decide +kernel

theorem poly1 : polyH (2 * 3) (codes.getD 1 0) = ofD (hists.getD 1 []) := by
  decide +kernel


/-- The certificates of all classes. -/
def certs : List (List (ℕ × ℕ × ℕ)) :=
  [certs0, certs1]

theorem chk_all : ∀ i < 2,
    chk (2 * 3) 2 (codes.getD i 0) codes (tuples (2 * 3)) (certs.getD i []) = true := by
  intro i hi
  interval_cases i
  exacts [chk0, chk1]

theorem poly_all : ∀ i < 2, polyH (2 * 3) (codes.getD i 0) = ofD (hists.getD i []) := by
  intro i hi
  interval_cases i
  exacts [poly0, poly1]


theorem hP (i : Fin 2) (t : ℕ) (ht : t ≤ 3 ^ 2) (_ : DecidableRel (R i).Adj) :
    iCount (R i) t = P i t := by
  have hh := allLt_iff.1 hist_ok i i.isLt
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, decide_eq_true_eq] at hh
  rw [iCount_ofCode_eq (wf i i.isLt) (by norm_num) (hh.1.trans (by norm_num)) hh.2
    (poly_all i i.isLt) t]
  have hp := allLt_iff.1 prof_ok i i.isLt
  rw [Bool.and_eq_true, allLt_iff] at hp
  have hp' := hp.2 t (Nat.lt_succ_of_le ht)
  rw [beq_iff_eq, sumLt_eq] at hp'
  exact hp'.symm

theorem hclosed : ∀ i (u₁ w₁ u₂ w₂ : Fin (2 * 3)), u₁ < w₁ → u₁ < u₂ → u₁ < w₂ →
    IsSwitch (R i) u₁ w₁ u₂ w₂ → ∃ j, Nonempty (twoSwitch (R i) u₁ w₁ u₂ w₂ ≃g R j) :=
  fun i u₁ w₁ u₂ w₂ h1 h2 h3 hs =>
    closure_of_chk (fun j hj => wf j hj) i.isLt (chk_all i i.isLt) u₁ w₁ u₂ w₂ h1 h2 h3 hs


theorem sep : ∀ i j : Fin 2, i ≠ j →
    prof.getD i [] ≠ prof.getD j [] ∨ False := by
  decide +kernel

theorem hsep : ∀ i j : Fin 2, i ≠ j →
    (∃ t ≤ 3 ^ 2, P i t ≠ P j t) ∨ (fun _ _ => False) i j := by
  intro i j hij
  rcases sep i j hij with h | h
  · obtain ⟨t, ht, hne⟩ := exists_getD_ne h (prof_len i) (prof_len j)
    exact Or.inl ⟨t, Nat.lt_succ_iff.1 ht, hne⟩
  · exact Or.inr h

/-- **Table 2, row `d = 3`.** -/
theorem row : Table2Row 3 2
    [(1, 28, 24)]
    [0, 2] :=
  table2Row_of_data R 0 P hdeg
    (noniso_of_prof R P hP (fun _ _ => False) (fun _ _ h => h.elim) hsep) hclosed hP hK
    (by decide) (by decide) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel)


end P3TS.D3
