/-- The representatives. -/
abbrev R (i : Fin 60) : SimpleGraph (Fin (2 * 5)) := ofCode (2 * 5) (codes.getD i 0)

/-- `N_{≤t}` of the representatives (from the table `prof`). -/
def P (i : Fin 60) (t : ℕ) : ℕ := (prof.getD i []).getD t 0

theorem wf_deg : allLt 60 (fun j => wfB (2 * 5) (codes.getD j 0) &&
    allLt (2 * 5) (fun v => degB (2 * 5) (codes.getD j 0) v == 5)) = true := by
  decide +kernel

theorem hist_ok : allLt 60 (fun j => (hists.getD j []).length == 46 &&
    (hists.getD j []).all (fun x => decide (x < 2048))) = true := by
  decide +kernel

theorem prof_ok : allLt 60 (fun j => (prof.getD j []).length == 5 ^ 2 + 1 && allLt (5 ^ 2 + 1)
    (fun t => (prof.getD j []).getD t 0 == sumLt (t + 1) (fun s => (hists.getD j []).getD s 0))) =
    true := by
  decide +kernel

theorem wf (j : ℕ) (hj : j < 60) : wfB (2 * 5) (codes.getD j 0) = true := by
  have h := allLt_iff.1 wf_deg j hj
  rw [Bool.and_eq_true] at h
  exact h.1

theorem hdeg (i : Fin 60) (v : Fin (2 * 5)) : (nbr (R i) v).card = 5 := by
  rw [card_nbr_ofCode (wf i i.isLt)]
  have h := allLt_iff.1 wf_deg i i.isLt
  rw [Bool.and_eq_true, allLt_iff] at h
  simpa using h.2 v v.isLt

theorem prof_len (i : Fin 60) : (prof.getD i []).length = 5 ^ 2 + 1 := by
  have h := allLt_iff.1 prof_ok i i.isLt
  rw [Bool.and_eq_true, beq_iff_eq] at h
  exact h.1

theorem hK : Nonempty (Kdd 5 ≃g R 0) :=
  ⟨⟨finSumFinEquiv.trans (finCongr (by norm_num)), by intro a b; revert a b; decide⟩⟩

