theorem chk_all : ∀ i < 6,
    chk (2 * 4) 6 (codes.getD i 0) codes (tuples (2 * 4)) (certs.getD i []) = true := by
  intro i hi
  interval_cases i
  exacts [chk0, chk1, chk2, chk3, chk4, chk5]

theorem poly_all : ∀ i < 6, polyH (2 * 4) (codes.getD i 0) = ofD (hists.getD i []) := by
  intro i hi
  interval_cases i
  exacts [poly0, poly1, poly2, poly3, poly4, poly5]


theorem hP (i : Fin 6) (t : ℕ) (ht : t ≤ 4 ^ 2) (_ : DecidableRel (R i).Adj) :
    iCount (R i) t = P i t := by
  have hh := allLt_iff.1 hist_ok i i.isLt
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, decide_eq_true_eq] at hh
  rw [iCount_ofCode_eq (wf i i.isLt) (by norm_num) (hh.1.trans (by norm_num)) hh.2
    (poly_all i i.isLt) t]
  have hp := allLt_iff.1 prof_ok i i.isLt
  rw [Bool.and_eq_true, allLt_iff] at hp
  have hp' := hp.2 t (Nat.lt_succ_of_le ht)
  rw [beq_iff_eq, sumLt_eq] at hp'
  exact hp'.symm

theorem hclosed : ∀ i (u₁ w₁ u₂ w₂ : Fin (2 * 4)), u₁ < w₁ → u₁ < u₂ → u₁ < w₂ →
    IsSwitch (R i) u₁ w₁ u₂ w₂ → ∃ j, Nonempty (twoSwitch (R i) u₁ w₁ u₂ w₂ ≃g R j) :=
  fun i u₁ w₁ u₂ w₂ h1 h2 h3 hs =>
    closure_of_chk (fun j hj => wf j hj) i.isLt (chk_all i i.isLt) u₁ w₁ u₂ w₂ h1 h2 h3 hs


theorem sep : ∀ i j : Fin 6, i ≠ j →
    prof.getD i [] ≠ prof.getD j [] ∨ False := by
  decide +kernel

theorem hsep : ∀ i j : Fin 6, i ≠ j →
    (∃ t ≤ 4 ^ 2, P i t ≠ P j t) ∨ (fun _ _ => False) i j := by
  intro i j hij
  rcases sep i j hij with h | h
  · obtain ⟨t, ht, hne⟩ := exists_getD_ne h (prof_len i) (prof_len j)
    exact Or.inl ⟨t, Nat.lt_succ_iff.1 ht, hne⟩
  · exact Or.inr h

/-- **Table 2, row `d = 4`.** -/
theorem row : Table2Row 4 6
    [(1, 61, 47), (3, 137, 127), (5, 187, 171)]
    [0, 4, 6] :=
  table2Row_of_data R 0 P hdeg
    (noniso_of_prof R P hP (fun _ _ => False) (fun _ _ h => h.elim) hsep) hclosed hP hK
    (by decide) (by decide) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel)


