/-- The representatives. -/
abbrev R (i : Fin 6) : SimpleGraph (Fin (2 * 4)) := ofCode (2 * 4) (codes.getD i 0)

/-- `N_{≤t}` of the representatives (from the table `prof`). -/
def P (i : Fin 6) (t : ℕ) : ℕ := (prof.getD i []).getD t 0

theorem wf_deg : allLt 6 (fun j => wfB (2 * 4) (codes.getD j 0) &&
    allLt (2 * 4) (fun v => degB (2 * 4) (codes.getD j 0) v == 4)) = true := by
  decide +kernel

theorem hist_ok : allLt 6 (fun j => (hists.getD j []).length == 29 &&
    (hists.getD j []).all (fun x => decide (x < 2048))) = true := by
  decide +kernel

theorem prof_ok : allLt 6 (fun j => (prof.getD j []).length == 4 ^ 2 + 1 && allLt (4 ^ 2 + 1)
    (fun t => (prof.getD j []).getD t 0 == sumLt (t + 1) (fun s => (hists.getD j []).getD s 0))) =
    true := by
  decide +kernel

theorem wf (j : ℕ) (hj : j < 6) : wfB (2 * 4) (codes.getD j 0) = true := by
  have h := allLt_iff.1 wf_deg j hj
  rw [Bool.and_eq_true] at h
  exact h.1

theorem hdeg (i : Fin 6) (v : Fin (2 * 4)) : (nbr (R i) v).card = 4 := by
  rw [card_nbr_ofCode (wf i i.isLt)]
  have h := allLt_iff.1 wf_deg i i.isLt
  rw [Bool.and_eq_true, allLt_iff] at h
  simpa using h.2 v v.isLt

theorem prof_len (i : Fin 6) : (prof.getD i []).length = 4 ^ 2 + 1 := by
  have h := allLt_iff.1 prof_ok i i.isLt
  rw [Bool.and_eq_true, beq_iff_eq] at h
  exact h.1

theorem hK : Nonempty (Kdd 4 ≃g R 0) :=
  ⟨⟨finSumFinEquiv.trans (finCongr (by norm_num)), by intro a b; revert a b; decide⟩⟩

