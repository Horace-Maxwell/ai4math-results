def unitCode (r : R5) : ℕ :=
  table[((r.1.val*5+r.2.1.val)*5+r.2.2.1.val)*5+r.2.2.2.val]!
def defect (r : R5) : Q5 := (unitCode r : Q5)
def correction (r : R5) : V := unitRep ((unitCode r / 5 : ℕ) : Q5) ⟨unitCode r / 25 % 20, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 24000 in
set_option maxHeartbeats 5000000 in
theorem normal_table : ∀ r : R5, rs r ≠ 0 →
    rm r (red (correction r)) = red (shape (defect r)) := by decide +kernel

def rrInv (r : R5) : R5 :=
  let two := rm r r
  let four := rm two two
  let eight := rm four four
  let sixteen := rm eight eight
  rm (rm sixteen two) r

set_option maxRecDepth 24000 in
set_option maxHeartbeats 5000000 in
theorem inv_table : ∀ r : R5, rs r ≠ 0 → rm r (rrInv r) = red (Cyc5.scalar 1) := by decide +kernel

set_option maxRecDepth 24000 in
set_option maxHeartbeats 6000000 in
theorem fixed_table : ∀ r : R5, rs r ≠ 0 → ∀ k : Q5,
    let v := rm (rc r) (rrInv r)
    rc v = rm (red (Cyc5.rootAt k)) v → defect r = 0 := by decide +kernel

