theorem fiveCliqueTwoPath_spec (r a b : Fin 6) (hab : a ≠ b)
    (hra : r ≠ a) (hrb : r ≠ b)
    (hbad : r ≠ 5 ∨ ¬ ((a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 0))) :
    fiveCliqueTwoPath r a b 0 = a ∧ fiveCliqueTwoPath r a b 4 = b ∧
      Function.Injective (fiveCliqueTwoPath r a b) ∧
      (∃ i : Fin 5, fiveCliqueTwoPath r a b i = r) ∧
      ∀ i : Fin 4, FiveCliqueTwoAdj
        (fiveCliqueTwoPath r a b i.castSucc) (fiveCliqueTwoPath r a b i.succ) := by
  have ht : ∀ r a b : Fin 6, a ≠ b → r ≠ a → r ≠ b →
      (r ≠ 5 ∨ ¬ ((a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 0))) →
      fiveCliqueTwoPath r a b 0 = a ∧ fiveCliqueTwoPath r a b 4 = b ∧
        Function.Injective (fiveCliqueTwoPath r a b) ∧
        (∃ i : Fin 5, fiveCliqueTwoPath r a b i = r) ∧
        ∀ i : Fin 4, FiveCliqueTwoAdj
          (fiveCliqueTwoPath r a b i.castSucc) (fiveCliqueTwoPath r a b i.succ) := by
    decide +kernel
  exact ht r a b hab hra hrb hbad

