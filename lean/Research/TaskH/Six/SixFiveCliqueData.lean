import Research.TaskH.Six.SixAttachmentData

/-!
Finite path certificates in one fixed six-point model: vertices 0,...,4
form a clique and vertex 5 is joined to 0 and 1. The certificate is a path
of five distinct positions, not an assumption on an original graph.
-/

set_option autoImplicit false

namespace TaskH.Six

/-- Exactly the edges guaranteed by a five-clique and two specified hooks. -/
def FiveCliqueTwoAdj (i j : Fin 6) : Prop :=
  i ≠ j ∧ ((i.val < 5 ∧ j.val < 5) ∨
    (i = 5 ∧ (j = 0 ∨ j = 1)) ∨ (j = 5 ∧ (i = 0 ∨ i = 1)))

instance fiveCliqueTwoAdjDecidable (i j : Fin 6) : Decidable (FiveCliqueTwoAdj i j) := by
  unfold FiveCliqueTwoAdj
  infer_instance

