theorem sixCliqueTwoPath_spec (r a b : Fin 7) (hab : a ≠ b)
    (hra : r ≠ a) (hrb : r ≠ b)
    (hbad : r ≠ 6 ∨ ¬ ((a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 0))) :
    sixCliqueTwoPath r a b 0 = a ∧ sixCliqueTwoPath r a b 5 = b ∧
      Function.Injective (sixCliqueTwoPath r a b) ∧
      (∃ i : Fin 6, sixCliqueTwoPath r a b i = r) ∧
      ∀ i : Fin 5, SixCliqueTwoAdj
        (sixCliqueTwoPath r a b i.castSucc) (sixCliqueTwoPath r a b i.succ) := by
  have ht : ∀ r a b : Fin 7, a ≠ b → r ≠ a → r ≠ b →
      (r ≠ 6 ∨ ¬ ((a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 0))) →
      sixCliqueTwoPath r a b 0 = a ∧ sixCliqueTwoPath r a b 5 = b ∧
        Function.Injective (sixCliqueTwoPath r a b) ∧
        (∃ i : Fin 6, sixCliqueTwoPath r a b i = r) ∧
        ∀ i : Fin 5, SixCliqueTwoAdj
          (sixCliqueTwoPath r a b i.castSucc) (sixCliqueTwoPath r a b i.succ) := by
    decide +kernel
  exact ht r a b hab hra hrb hbad

