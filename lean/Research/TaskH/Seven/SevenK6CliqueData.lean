def SixCliqueTwoAdj (i j : Fin 7) : Prop :=
  i ≠ j ∧ ((i.val < 6 ∧ j.val < 6) ∨
    (i = 6 ∧ (j = 0 ∨ j = 1)) ∨ (j = 6 ∧ (i = 0 ∨ i = 1)))

instance sixCliqueTwoAdjDecidable (i j : Fin 7) : Decidable (SixCliqueTwoAdj i j) := by
  unfold SixCliqueTwoAdj
  infer_instance

