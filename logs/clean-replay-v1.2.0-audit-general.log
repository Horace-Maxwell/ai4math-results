def ICGGeneral.phiX : ℝ → ℕ → ℝ :=
fun x e => if e = 0 then 1 else x ^ (e - 1) * (x - 1)
def ICGGeneral.ramX : ℝ → ℕ → ℕ → ℝ :=
fun x k u => if k = 0 then 1 else if k ≤ u then ICGGeneral.phiX x k else if k = u + 1 then -x ^ u else 0
def ICGGeneral.Tent : ℝ → ℕ → ℕ → ℕ → ℝ :=
fun x m u j => ICGGeneral.phiX x (m - u) * ICGGeneral.ramX x (m - j) u
def ICGGeneral.Tv : ℝ → ℕ → (ℕ → ℝ) → ℕ → ℝ :=
fun x m w u => ∑ j ∈ Finset.range (m + 1), ICGGeneral.Tent x m u j * w j
def ICGGeneral.L1 : ℝ → ℕ → (ℕ → ℝ) → ℝ :=
fun x m w => ∑ u ∈ Finset.range (m + 1), |ICGGeneral.Tv x m w u|
def ICGGeneral.sgnv : ℕ → ℝ :=
fun i => (-1) ^ i
def ICGGeneral.Mentry : ℝ → ℝ → ℕ → ℕ → (ℕ → ℕ → ℝ) → ℕ → ℕ → ℝ :=
fun p q a b Y u v =>
  ∑ i ∈ Finset.range (a + 1), ∑ l ∈ Finset.range (b + 1), ICGGeneral.Tent p a u i * Y i l * ICGGeneral.Tent q b v l
def ICGGeneral.L1mat : ℝ → ℝ → ℕ → ℕ → (ℕ → ℕ → ℝ) → ℝ :=
fun p q a b Y => ∑ u ∈ Finset.range (a + 1), ∑ v ∈ Finset.range (b + 1), |ICGGeneral.Mentry p q a b Y u v|
def ICGGeneral.DstarPQ : ℕ → ℕ → ℕ → ℕ → Finset ℕ :=
fun p q a b =>
  Finset.image (fun ij => p ^ ij.1 * q ^ ij.2)
    ({ij ∈ Finset.range (a + 1) ×ˢ Finset.range (b + 1) | Even (ij.1 + ij.2)})
def ICGBridge.icgAdj : (n : ℕ) → Finset ℕ → Matrix (Fin n) (Fin n) ℝ :=
fun n D => Matrix.of fun i j => if (↑(j - i)).gcd n ∈ D then 1 else 0
def ICGBridge.energy.{u_1} : {ι : Type u_1} → [Fintype ι] → [DecidableEq ι] → (A : Matrix ι ι ℝ) → A.IsHermitian → ℝ :=
fun {ι} [Fintype ι] [DecidableEq ι] A hA => ∑ i, |hA.eigenvalues i|
@ICGGeneral.L1_path : ∀ {x : ℝ},
  0 < x →
    ∀ (m : ℕ) (w : ℕ → ℝ),
      ICGGeneral.L1 x m w =
        x ^ m * (|ICGGeneral.Zp x m w 0| + ∑ k ∈ Finset.range m, |ICGGeneral.Zp x m w k - ICGGeneral.Zp x m w (k + 1)|)
@ICGGeneral.L1_sign : ∀ {x : ℝ},
  2 < x →
    ∀ {m : ℕ} {y : ℕ → ℝ},
      ICGGeneral.IsSign m y →
        ICGGeneral.L1 x m y =
          x ^ m * (∑ k ∈ Finset.range m, ICGGeneral.cc x k + ICGGeneral.nu x m - ICGGeneral.slack x m y)
@ICGGeneral.L1_le_sgnv : ∀ {x : ℝ},
  2 < x → ∀ {m : ℕ} {y : ℕ → ℝ}, ICGGeneral.IsSign m y → ICGGeneral.L1 x m y ≤ ICGGeneral.L1 x m ICGGeneral.sgnv
@ICGGeneral.L1_eq_sgnv : ∀ {x : ℝ},
  2 < x →
    ∀ {m : ℕ} {y : ℕ → ℝ},
      ICGGeneral.IsSign m y →
        ICGGeneral.L1 x m y = ICGGeneral.L1 x m ICGGeneral.sgnv →
          (∀ i ≤ m, y i = ICGGeneral.sgnv i) ∨ ∀ i ≤ m, y i = -ICGGeneral.sgnv i
@ICGGeneral.Tv_sgnv_last_pos : ∀ {x : ℝ}, 2 < x → ∀ (m : ℕ), 0 < ICGGeneral.Tv x m ICGGeneral.sgnv m
@ICGGeneral.hcell_le : ∀ {P μ : ℝ},
  0 ≤ μ → μ ≤ 1 → μ ≤ P → ∀ (A B : ℝ), ICGGeneral.hcell P μ A B ≤ 2 * μ * max 0 (|B| - P * |A|)
@ICGGeneral.local_ineq : ∀ {q P μ : ℝ},
  3 ≤ q →
    4 ≤ P →
      3 / 5 ≤ μ →
        μ ≤ 1 →
          ∀ {b : ℕ} {y ζ : ℕ → ℝ},
            ICGGeneral.IsSign b y →
              (∀ i ≤ b, |ζ i| ≤ 1) →
                ((P * ICGGeneral.L1 q b fun i => y i - ζ i) + μ * ICGGeneral.L1 q b fun i => ζ i + P * y i) -
                    (P - μ) * ICGGeneral.L1 q b ζ ≤
                  P * (1 + μ) * ICGGeneral.L1 q b ICGGeneral.sgnv
@ICGGeneral.local_ineq_strict : ∀ {q P μ : ℝ},
  3 ≤ q →
    4 ≤ P →
      3 / 5 ≤ μ →
        μ ≤ 1 →
          ∀ {b : ℕ} {y ζ : ℕ → ℝ},
            ICGGeneral.IsSign b y →
              (∀ i ≤ b, |ζ i| ≤ 1) →
                (∃ j < b, y j = y (j + 1)) →
                  ((P * ICGGeneral.L1 q b fun i => y i - ζ i) + μ * ICGGeneral.L1 q b fun i => ζ i + P * y i) -
                      (P - μ) * ICGGeneral.L1 q b ζ <
                    P * (1 + μ) * ICGGeneral.L1 q b ICGGeneral.sgnv
@ICGGeneral.thm5_le : ∀ {p q : ℝ},
  5 ≤ p →
    3 ≤ q →
      ∀ {a b : ℕ} {Y : ℕ → ℕ → ℝ},
        (∀ i ≤ a, ICGGeneral.IsSign b (Y i)) →
          ICGGeneral.L1mat p q a b Y ≤ ICGGeneral.L1 p a ICGGeneral.sgnv * ICGGeneral.L1 q b ICGGeneral.sgnv
@ICGGeneral.thm5_eq : ∀ {p q : ℝ},
  5 ≤ p →
    3 ≤ q →
      ∀ {a b : ℕ} {Y : ℕ → ℕ → ℝ},
        (∀ i ≤ a, ICGGeneral.IsSign b (Y i)) →
          ICGGeneral.L1mat p q a b Y = ICGGeneral.L1 p a ICGGeneral.sgnv * ICGGeneral.L1 q b ICGGeneral.sgnv →
            (∀ i ≤ a, ∀ l ≤ b, Y i l = ICGGeneral.sgnv i * ICGGeneral.sgnv l) ∨
              ∀ i ≤ a, ∀ l ≤ b, Y i l = -(ICGGeneral.sgnv i * ICGGeneral.sgnv l)
ICGGeneral.L1mat_sgnv : ∀ (p q : ℝ) (a b : ℕ),
  (ICGGeneral.L1mat p q a b fun i l => ICGGeneral.sgnv i * ICGGeneral.sgnv l) =
    ICGGeneral.L1 p a ICGGeneral.sgnv * ICGGeneral.L1 q b ICGGeneral.sgnv
@ICGGeneral.thm5_le_swap : ∀ {p q : ℝ},
  3 ≤ p →
    5 ≤ q →
      ∀ {a b : ℕ} {Y : ℕ → ℕ → ℝ},
        (∀ i ≤ a, ICGGeneral.IsSign b (Y i)) →
          ICGGeneral.L1mat p q a b Y ≤ ICGGeneral.L1 p a ICGGeneral.sgnv * ICGGeneral.L1 q b ICGGeneral.sgnv
@ICGGeneral.thm5_eq_swap : ∀ {p q : ℝ},
  3 ≤ p →
    5 ≤ q →
      ∀ {a b : ℕ} {Y : ℕ → ℕ → ℝ},
        (∀ i ≤ a, ICGGeneral.IsSign b (Y i)) →
          ICGGeneral.L1mat p q a b Y = ICGGeneral.L1 p a ICGGeneral.sgnv * ICGGeneral.L1 q b ICGGeneral.sgnv →
            (∀ i ≤ a, ∀ l ≤ b, Y i l = ICGGeneral.sgnv i * ICGGeneral.sgnv l) ∨
              ∀ i ≤ a, ∀ l ≤ b, Y i l = -(ICGGeneral.sgnv i * ICGGeneral.sgnv l)
ICGGeneral.energy_icgAdj_pq : ∀ (p q a b : ℕ),
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        ∀ (D : Finset ℕ),
          ICGBridge.energy (ICGBridge.icgAdj (p ^ a * q ^ b) D) ⋯ =
            ICGGeneral.L1mat (↑p) (↑q) a b fun c e => if p ^ c * q ^ e ∈ D then 1 else 0
ICGGeneral.checkerboard_unique_max : ∀ (p q a b : ℕ),
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        5 ≤ p →
          3 ≤ q →
            Odd (a + b) →
              ∀ D ⊆ (p ^ a * q ^ b).properDivisors,
                D ≠ ICGGeneral.DstarPQ p q a b →
                  ICGBridge.energy (ICGBridge.icgAdj (p ^ a * q ^ b) D) ⋯ <
                    ICGBridge.energy (ICGBridge.icgAdj (p ^ a * q ^ b) (ICGGeneral.DstarPQ p q a b)) ⋯
@ICGGeneral.energy_DstarPQ : ∀ {p q : ℕ},
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        3 ≤ p →
          3 ≤ q →
            ∀ (a b : ℕ),
              2 * ICGBridge.energy (ICGBridge.icgAdj (p ^ a * q ^ b) (ICGGeneral.DstarPQ p q a b)) ⋯ =
                ↑p ^ a * ↑q ^ b + ICGGeneral.L1 (↑p) a ICGGeneral.sgnv * ICGGeneral.L1 (↑q) b ICGGeneral.sgnv
ICGGeneral.jiang_yang_q3 : ∀ (p r s : ℕ),
  Nat.Prime p →
    5 ≤ p →
      ∀ D ⊆ (p ^ (2 * r) * 3 ^ (2 * s + 1)).properDivisors,
        D ≠ ICGGeneral.DstarPQ p 3 (2 * r) (2 * s + 1) →
          ICGBridge.energy (ICGBridge.icgAdj (p ^ (2 * r) * 3 ^ (2 * s + 1)) D) ⋯ <
            ICGBridge.energy
              (ICGBridge.icgAdj (p ^ (2 * r) * 3 ^ (2 * s + 1)) (ICGGeneral.DstarPQ p 3 (2 * r) (2 * s + 1))) ⋯
ICGGeneral.jiang_yang_q3_value : ∀ (p r s : ℕ),
  Nat.Prime p →
    5 ≤ p →
      2 *
          ICGBridge.energy
            (ICGBridge.icgAdj (p ^ (2 * r) * 3 ^ (2 * s + 1)) (ICGGeneral.DstarPQ p 3 (2 * r) (2 * s + 1))) ⋯ =
        ↑p ^ (2 * r) * 3 ^ (2 * s + 1) +
          ICGGeneral.L1 (↑p) (2 * r) ICGGeneral.sgnv * ICGGeneral.L1 3 (2 * s + 1) ICGGeneral.sgnv
ICGGeneral.DstarPQ_admissible : ∀ (p r s : ℕ),
  Nat.Prime p →
    5 ≤ p →
      ICGGeneral.DstarPQ p 3 (2 * r) (2 * s + 1) ⊆ (p ^ (2 * r) * 3 ^ (2 * s + 1)).properDivisors ∧
        1 ∈ ICGGeneral.DstarPQ p 3 (2 * r) (2 * s + 1)
ICGGeneral.checkerboard_unique_max_odd : ∀ (p q a b : ℕ),
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        p ≠ 2 →
          q ≠ 2 →
            Odd (a + b) →
              ∀ D ⊆ (p ^ a * q ^ b).properDivisors,
                D ≠ ICGGeneral.DstarPQ p q a b →
                  ICGBridge.energy (ICGBridge.icgAdj (p ^ a * q ^ b) D) ⋯ <
                    ICGBridge.energy (ICGBridge.icgAdj (p ^ a * q ^ b) (ICGGeneral.DstarPQ p q a b)) ⋯
ICGGeneral.jiang_yang_thmA : ∀ (p q r s : ℕ),
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        p ≠ 2 →
          q ≠ 2 →
            ∀ D ⊆ (p ^ (2 * r) * q ^ (2 * s + 1)).properDivisors,
              D ≠ ICGGeneral.DstarPQ p q (2 * r) (2 * s + 1) →
                ICGBridge.energy (ICGBridge.icgAdj (p ^ (2 * r) * q ^ (2 * s + 1)) D) ⋯ <
                  ICGBridge.energy
                    (ICGBridge.icgAdj (p ^ (2 * r) * q ^ (2 * s + 1)) (ICGGeneral.DstarPQ p q (2 * r) (2 * s + 1))) ⋯
ICGGeneral.DstarPQ_roldan : ∀ (p : ℕ), ICGGeneral.DstarPQ p 3 2 3 = ICGBridge.Dstar p
