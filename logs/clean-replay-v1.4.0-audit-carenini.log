def Carenini.edgesIn.{u_1} : {V : Type u_1} →
  [Fintype V] → [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → Finset V → ℕ :=
fun {V} [Fintype V] [DecidableEq V] G [DecidableRel G.Adj] A => {x ∈ G.edgeFinset | x ∈ A.sym2}.card
def Carenini.iCount.{u_1} : {V : Type u_1} →
  [Fintype V] → [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → ℕ → ℕ :=
fun {V} [Fintype V] [DecidableEq V] G [DecidableRel G.Adj] t => {A | Carenini.edgesIn G A ≤ t}.card
def Carenini.iGamma.{u_1} : {V : Type u_1} →
  [Fintype V] → [DecidableEq V] → (G : SimpleGraph V) → [DecidableRel G.Adj] → ℕ → ℝ → ℕ :=
fun {V} [Fintype V] [DecidableEq V] G [DecidableRel G.Adj] d γ =>
  {A | ↑(Carenini.edgesIn G A) ≤ γ * ↑d * ↑(Fintype.card V)}.card
def Carenini.KddUnion : (m d : ℕ) → SimpleGraph (Fin m × (Fin d ⊕ Fin d)) :=
fun m d =>
  { Adj := fun x y => x.1 = y.1 ∧ (completeBipartiteGraph (Fin d) (Fin d)).Adj x.2 y.2, symm := ⋯, loopless := ⋯ }
def Carenini.CareniniQuestion : ℕ → ℕ → ℝ → Prop :=
fun n d γ =>
  ∀ (V : Type) [inst : Fintype V] [inst_1 : DecidableEq V] (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj],
    Fintype.card V = n →
      G.IsRegularOfDegree d → Carenini.iGamma G d γ ≤ Carenini.iGamma (Carenini.KddUnion (n / (2 * d)) d) d γ
def Carenini.K33 : SimpleGraph (Fin 6) :=
{ Adj := fun i j => ↑i < 3 ∧ 3 ≤ ↑j ∨ 3 ≤ ↑i ∧ ↑j < 3, symm := Carenini.K33._proof_3,
  loopless := Carenini.K33._proof_4 }
def Carenini.prism : SimpleGraph (Fin 6) :=
{ Adj := fun i j => i ≠ j ∧ ((↑i < 3 ↔ ↑j < 3) ∨ ↑i % 3 = ↑j % 3), symm := Carenini.prism._proof_1,
  loopless := Carenini.prism._proof_2 }
def Carenini.swAdj : {d : ℕ} → Fin d ⊕ Fin d → Fin d ⊕ Fin d → Prop :=
fun {d} x x_1 =>
  match x, x_1 with
  | Sum.inl a, Sum.inl b => ↑a = 0 ∧ ↑b = 1 ∨ ↑a = 1 ∧ ↑b = 0
  | Sum.inr a, Sum.inr b => ↑a = 0 ∧ ↑b = 1 ∨ ↑a = 1 ∧ ↑b = 0
  | Sum.inl a, Sum.inr b => ¬(↑a = ↑b ∧ ↑a ≤ 1)
  | Sum.inr a, Sum.inl b => ¬(↑a = ↑b ∧ ↑a ≤ 1)
def Carenini.switchedKdd : (d : ℕ) → SimpleGraph (Fin d ⊕ Fin d) :=
fun d => { Adj := Carenini.swAdj, symm := ⋯, loopless := ⋯ }
def Carenini.C8 : SimpleGraph (Fin 8) :=
{ Adj := fun i j => (↑i + 1) % 8 = ↑j ∨ (↑j + 1) % 8 = ↑i, symm := Carenini.C8._proof_2,
  loopless := Carenini.C8._proof_3 }
def Carenini.h3Adj : Fin 12 → Fin 12 → Bool :=
fun i j =>
  have a := ↑i;
  have b := ↑j;
  have cross := decide (a % 6 < 3) != decide (b % 6 < 3);
  have same := a / 6 == b / 6;
  have removed := a == 0 && b == 3 || a == 3 && b == 0 || a == 6 && b == 9 || a == 9 && b == 6;
  have added := a == 0 && b == 9 || a == 9 && b == 0 || a == 6 && b == 3 || a == 3 && b == 6;
  cross && same && !removed || added
def Carenini.H3 : SimpleGraph (Fin 12) :=
{ Adj := fun i j => Carenini.h3Adj i j = true, symm := Carenini.H3._proof_1, loopless := Carenini.H3._proof_2 }
def Carenini.threeK4 : SimpleGraph (Fin 12) :=
{ Adj := fun i j => i ≠ j ∧ ↑i / 4 = ↑j / 4, symm := Carenini.threeK4._proof_1, loopless := Carenini.threeK4._proof_2 }
