def HKOTriameter.FP : ℕ → ℕ → ℕ → Prop :=
fun A B C => A = B ∧ C ≤ A + 2 ∨ A = C ∧ B ≤ A + 2 ∨ B = C ∧ A ≤ B + 2
def HKOTriameter.FourPointBM.{u_1} : {V : Type u_1} → SimpleGraph V → Prop :=
fun {V} G => ∀ (u v w x : V), FP (G.dist u v + G.dist w x) (G.dist u w + G.dist v x) (G.dist u x + G.dist v w)
def HKOTriameter.Problem3ClaimFP : Prop :=
∀ (V : Type) [inst : Fintype V] (G : SimpleGraph V), G.Connected → FourPointBM G → Question3' G ∨ Question4 G
def HKOTriameter.f1gEdges : List (ℕ × ℕ) :=
[(0, 1), (1, 2), (1, 3), (1, 4), (2, 5), (3, 5), (4, 5)]
def HKOTriameter.f1hEdges : List (ℕ × ℕ) :=
[(0, 3), (0, 4), (0, 5), (1, 3), (1, 4), (1, 5), (2, 3), (2, 4), (2, 5), (3, 4), (4, 5)]
def SimpleGraph.dist.{u_1} : {V : Type u_1} → SimpleGraph V → V → V → ℕ :=
fun {V} G u v => (G.edist u v).toNat
def SimpleGraph.edist.{u_1} : {V : Type u_1} → SimpleGraph V → V → V → ℕ∞ :=
fun {V} G u v => ⨅ w, ↑w.length
def SimpleGraph.diam.{u_1} : {α : Type u_1} → SimpleGraph α → ℕ :=
fun {α} G => G.ediam.toNat
def SimpleGraph.ediam.{u_1} : {α : Type u_1} → SimpleGraph α → ℕ∞ :=
fun {α} G => ⨆ u, G.eccent u
def SimpleGraph.eccent.{u_1} : {α : Type u_1} → SimpleGraph α → α → ℕ∞ :=
fun {α} G u => ⨆ v, G.edist u v
