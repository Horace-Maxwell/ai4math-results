info: Research/ICGEqualParityBAudit.lean:18:0: ICGEqualParityB.theoremB : ∀ (p q b : ℕ),
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        3 ≤ p →
          3 ≤ q →
            Even b →
              2 ≤ b →
                ∀ D ⊆ (p ^ 2 * q ^ b).properDivisors,
                  ICGBridge.energy (ICGBridge.icgAdj (p ^ 2 * q ^ b) D) ⋯ ≤
                      (↑p ^ 2 * ↑q ^ b + (5 * ↑p ^ 2 - 8 * ↑p + 4) * ICGGeneral.L1 (↑q) b ICGGeneral.sgnv) / 2 -
                        (↑p ^ 2 - 2 * ↑p + 2) * ICGGeneral.Tv (↑q) b ICGGeneral.sgnv b ∧
                    (ICGBridge.energy (ICGBridge.icgAdj (p ^ 2 * q ^ b) D) ⋯ =
                        (↑p ^ 2 * ↑q ^ b + (5 * ↑p ^ 2 - 8 * ↑p + 4) * ICGGeneral.L1 (↑q) b ICGGeneral.sgnv) / 2 -
                          (↑p ^ 2 - 2 * ↑p + 2) * ICGGeneral.Tv (↑q) b ICGGeneral.sgnv b ↔
                      D = ICGEqualParity.DantiPQ p q 2 b ∨ D = ICGEqualParityB.DtruncB p q b)
info: Research/ICGEqualParityBAudit.lean:19:0: ICGEqualParityB.corollaryB : ∀ (p q b : ℕ),
