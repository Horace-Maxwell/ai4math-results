info: Research/Backfill/Paper5/Proof/ReesCoreCompat.lean:316:0: 'CodexPaper5.ReesCoreCompat.lemmaB' depends on axioms: [propext, Classical.choice, Quot.sound]
info: Research/Backfill/Paper5/Proof/ReesCoreCompat.lean:319:0: @CodexPaper5.ReesCoreCompat.lemmaC : ∀ {H : Type u_1} (P : H → H → Option (ZMod 2)) (L : H → H → H) (ρ : H ≃ H)
  (c s : H → ZMod 2) [Finite H],
  (∀ (l : H), P l l = some 0) →
    (∀ (l : H), P l (ρ l) = some (s l)) →
      (∀ (l : H), c (ρ l) = c l + 1 + s l) →
        (∀ (i : H), Function.Injective (L i)) →
          (∀ (l : H), Function.Injective fun i => L i l) →
            CodexPaper5.ReesCoreCompat.IsCompleteMapping (CodexPaper5.ReesCoreCompat.mul P)
              (CodexPaper5.ReesCoreCompat.fC L ρ c)
info: Research/Backfill/Paper5/Proof/ReesCoreCompat.lean:320:0: @CodexPaper5.ReesCoreCompat.lemmaB : ∀ {H : Type u_1} (P : H → H → Option (ZMod 2)) (L : H → H → H) (δ : H ≃ H)
  (t : H → ZMod 2) [Finite H],
  (∀ (l : H), P l l = some 0) →
    (∀ (μ : H), t (δ μ) = t μ + 1) →
      (∀ (i : H), Function.Injective (L i)) →
        (∀ (l : H), Function.Injective fun i => L i l) →
          CodexPaper5.ReesCoreCompat.IsCompleteMapping (CodexPaper5.ReesCoreCompat.mul P)
            (CodexPaper5.ReesCoreCompat.fB L δ t)
info: Research/Backfill/Paper5/Proof/ReesCoreCompat.lean:321:0: def CodexPaper5.ReesCoreCompat.mul.{u_1} : {H : Type u_1} →
  (H → H → Option (ZMod 2)) →
    CodexPaper5.ReesCoreCompat.Elt H → CodexPaper5.ReesCoreCompat.Elt H → CodexPaper5.ReesCoreCompat.Elt H :=
fun {H} P x x_1 =>
  match x, x_1 with
  | none, x => none
  | some val, none => none
  | some (i, a, l), some (j, b, m) => Option.map (fun p => (i, a + p + b, m)) (P l j)
info: Research/Backfill/Paper5/Proof/ReesCoreCompat.lean:322:0: def CodexPaper5.ReesCoreCompat.fC.{u_1} : {H : Type u_1} →
  (H → H → H) → H ≃ H → (H → ZMod 2) → CodexPaper5.ReesCoreCompat.Elt H → CodexPaper5.ReesCoreCompat.Elt H :=
fun {H} L ρ c x =>
  match x with
  | none => none
  | some (i, a, l) => if a = c l then some (l, 1 + c l, L i l) else some (ρ l, c (ρ l), L i (ρ l))
info: Research/Backfill/Paper5/Proof/ReesCoreCompat.lean:323:0: def CodexPaper5.ReesCoreCompat.fB.{u_1} : {H : Type u_1} →
  (H → H → H) → H ≃ H → (H → ZMod 2) → CodexPaper5.ReesCoreCompat.Elt H → CodexPaper5.ReesCoreCompat.Elt H :=
fun {H} L δ t x =>
  match x with
  | none => none
  | some (i, a, l) => if a = 1 + t (L i l) then some (l, 1, L i l) else some (l, 0, δ (L i l))
info: Research/Backfill/Paper5/Proof/ReesCoreCompat.lean:324:0: def CodexPaper5.ReesCoreCompat.IsCompleteMapping.{u_2} : {S : Type u_2} → (S → S → S) → (S → S) → Prop :=
fun {S} op α => Function.Bijective α ∧ Function.Bijective fun x => op x (α x)
