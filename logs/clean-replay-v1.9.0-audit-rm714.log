def RM714.evalPoly : List (Finset (Fin 14)) → (Fin 14 → ZMod 2) → ZMod 2 :=
fun L x => (List.map (fun S => ∏ i ∈ S, x i) L).sum
def RM714.weight : List (Finset (Fin 14)) → ℕ :=
fun L => {x | RM714.evalPoly L x = 1}.card
def RM714.IsRM714Weight : ℕ → Prop :=
fun w => ∃ L, (∀ S ∈ L, S.card ≤ 7) ∧ RM714.weight L = w
RM714.rm714_new_weights : ∀
