  RM714.IsRM714Weight w
RM714.weight_map_maskSet : ∀ (L : List ℕ),
  (∀ s ∈ L, s < 2 ^ 14) → RM714.weight (List.map RM714.maskSet L) = RM714.weightNat L
RM714.isRM714Weight_of : ∀ (L : List ℕ) (w : ℕ),
  (∀ s ∈ L, s < 2 ^ 14) →
    (L.all fun s => decide (RM714.degNat s ≤ 7)) = true → RM714.weightNat L = w → RM714.IsRM714Weight w
