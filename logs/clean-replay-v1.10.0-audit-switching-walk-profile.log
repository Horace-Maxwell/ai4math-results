def SwitchingWalkProfile.switchVec.{u_1} : {ι : Type u_1} → [DecidableEq ι] → ι → ι → ℝ :=
fun {ι} [DecidableEq ι] v i => if i = v then -1 else 1
@SwitchingWalkProfile.annihilator : ∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (A : Matrix ι ι ℝ),
  Aᵀ = A →
    ∀ (k : ℝ),
      ((A *ᵥ fun x => 1) = k • fun x => 1) →
        Fintype.card ι ≠ 2 →
          ∀ (v : ι) (w : ι → ℝ),
            (∀ (u : ι), 0 < w u) →
              (∀ (j : ℕ), (A ^ j) v v = ∑ u, w u * (A ^ j) u u) →
                ∀ (f : Polynomial ℝ),
                  (Polynomial.aeval A) f *ᵥ SwitchingWalkProfile.switchVec v = 0 → (Polynomial.aeval A) f = 0
@SwitchingWalkProfile.eigen_nonorth : ∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (A : Matrix ι ι ℝ),
  Aᵀ = A →
    ∀ (k : ℝ),
      ((A *ᵥ fun x => 1) = k • fun x => 1) →
        Fintype.card ι ≠ 2 →
          ∀ (v : ι) (w : ι → ℝ),
            (∀ (u : ι), 0 < w u) →
              (∀ (j : ℕ), (A ^ j) v v = ∑ u, w u * (A ^ j) u u) →
                ∀ (θ : ℝ) (x : ι → ℝ),
                  x ≠ 0 → A *ᵥ x = θ • x → ∃ y, A *ᵥ y = θ • y ∧ SwitchingWalkProfile.switchVec v ⬝ᵥ y ≠ 0
@SwitchingWalkProfile.main_after_switching : ∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]
  (A : Matrix ι ι ℝ),
  Aᵀ = A →
    ∀ (k : ℝ),
      ((A *ᵥ fun x => 1) = k • fun x => 1) →
        Fintype.card ι ≠ 2 →
          ∀ (v : ι) (w : ι → ℝ),
            (∀ (u : ι), 0 < w u) →
              (∀ (j : ℕ), (A ^ j) v v = ∑ u, w u * (A ^ j) u u) →
                ∀ (θ : ℝ) (x : ι → ℝ),
                  x ≠ 0 →
                    (diagonal (SwitchingWalkProfile.switchVec v) * A * diagonal (SwitchingWalkProfile.switchVec v)) *ᵥ
                          x =
                        θ • x →
                      ∃ z,
                        (diagonal (SwitchingWalkProfile.switchVec v) * A *
                                diagonal (SwitchingWalkProfile.switchVec v)) *ᵥ
                              z =
                            θ • z ∧
                          (fun x => 1) ⬝ᵥ z ≠ 0
